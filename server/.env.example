# ---- Core ----
PORT=4000
NODE_ENV=development

# Secret used to sign access tokens. MUST be set to a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_SECONDS=43200

# Absolute or relative path to the SQLite database file.
DATABASE_FILE=./data/guardians.db

# Password given to every account created by an admin, before the forced reset.
DEFAULT_USER_PASSWORD=Guardians@123

# ---- Google Drive ----
# DRIVE_PROVIDER=mock   -> in-memory sample Drive tree, no credentials needed (dev/demo/tests)
# DRIVE_PROVIDER=google -> the real Google Drive API via a service account
DRIVE_PROVIDER=mock

# Service-account credentials (only needed when DRIVE_PROVIDER=google).
# Either point at the downloaded JSON key file...
GOOGLE_SERVICE_ACCOUNT_FILE=./google-service-account.json
# ...or supply the two fields inline.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Optional: impersonate a Workspace user so the service account sees shared drives.
GOOGLE_IMPERSONATE_SUBJECT=

# ---- Seed data ----
SEED_MASTER_EMAIL=chro@guardians.example
SEED_MASTER_PASSWORD=Master@123
